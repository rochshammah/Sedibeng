NODE_ENV=development
PORT=5000
NEON_DATABASE_URL=
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_BOOTSTRAP_SECRET=
COOKIE_SAME_SITE=lax

# --- Private storage for teacher verification documents (Phase 3) ---------------
# Use any S3-compatible bucket that is NOT public (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Documents are only ever opened through short-lived signed links. Until these are set,
# uploads return "Document storage is not configured on this server."
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS: your region (e.g. af-south-1). Cloudflare R2: "auto".
S3_REGION=us-east-1
# Only for non-AWS providers, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Set to "true" for MinIO and some other providers.
S3_FORCE_PATH_STYLE=false
# How long a signed document link works, in seconds (15-300, default 60).
DOCUMENT_URL_TTL_SECONDS=60
# Development ONLY: keep files on local disk instead of a bucket. Ignored when NODE_ENV=production.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.private-storage
