NODE_ENV=development
PORT=5000
NEON_DATABASE_URL=
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_BOOTSTRAP_SECRET=
COOKIE_SAME_SITE=lax

# --- Private storage for teacher verification documents --------------------------
# Cloudinary (recommended). Copy the "API Environment variable" from
# Cloudinary > Settings > API Keys. NEVER commit real values; set them only in Render.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dqq9flvc1
# Folder the documents are kept in (default "sedibeng").
CLOUDINARY_FOLDER=sedibeng
# Documents are uploaded as private ("authenticated") files and opened only through
# short-lived links on this API. How long a link works, in seconds (15-300, default 60):
DOCUMENT_URL_TTL_SECONDS=60

# Alternative: any S3-compatible private bucket (AWS S3, Cloudflare R2, Backblaze B2).
# Used only when Cloudinary is not configured, or when STORAGE_DRIVER=s3.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Development ONLY: keep files on local disk. Ignored when NODE_ENV=production.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.private-storage
